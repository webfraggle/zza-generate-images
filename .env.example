# Konfiguration für den Server-Build (cmd/zza-server).
# Die Desktop-App (cmd/zza) liest keine Env-Vars.

# HTTP
PORT=8080

# Templates & Cache
TEMPLATES_DIR=./templates
CACHE_DIR=./cache
CACHE_MAX_AGE_HOURS=24
CACHE_MAX_SIZE_MB=500
# Cache der ZZA-Pakete (GET /{template}/zza.zip), eigener Ordner zza/ im CACHE_DIR
ZZA_CACHE_MAX_SIZE_MB=50
